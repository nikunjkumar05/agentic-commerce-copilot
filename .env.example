RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MISTRAL_API_KEY=
DATABASE_URL=
VITE_RAZORPAY_KEY_ID=
LIGHTHOUSE_API_KEY=
# Webhook HMAC secret (from Razorpay Dashboard -> Settings -> Webhooks).
# REQUIRED for webhook verification — the endpoint fails closed without it.
RAZORPAY_WEBHOOK_SECRET=
# Route split: linked account for autonomous GST withholding (acc_xxx). Leave empty to use virtual allocation.
RAZORPAY_LINKED_ACCOUNT_ID=
# Autonomous S2S mandate payment is per-user only: each buyer binds their own
# saved card token + customer id via the CFO Portal (/api/user/razorpay-mandate).
# There is intentionally NO global token env var — a shared token would let one
# merchant's mandate settle another merchant's invoice. Leave unbound to use
# Payment-Link escalation instead.
# x402 two-identity loop: email of the merchant (AI Seller) account. Auto-seeded if missing.
MERCHANT_AGENT_EMAIL=
